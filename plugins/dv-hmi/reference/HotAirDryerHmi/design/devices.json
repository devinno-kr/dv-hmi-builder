{
  "devices": [
    {
      "id": "d.dryer",
      "name": "열풍 건조기",
      "code": "Dryer",
      "xml": "dryer.xml",
      "protocol": "Modbus TCP",
      "connection": { "ip": "192.168.0.50", "port": 502, "unit": 1, "note": "기본값. 설정 화면에서 바꾼다 (시뮬레이션이면 127.0.0.1:1502)" },
      "simulator": { "code": "DryerSimulator", "port": 1502, "note": "온도는 히터 출력대로 오르내리고, 단계 시간은 레시피대로 줄어든다. 고장 버튼으로 경보 비트를 켤 수 있다" },
      "basis": "manual",
      "from": 1, "at": 3,
      "map": [
        { "address": "40001", "name": "건조실 온도", "code": "ChamberTemp", "type": "int16", "scale": 0.1, "unit": "℃", "access": "R" },
        { "address": "40002", "name": "배기 온도", "code": "ExhaustTemp", "type": "int16", "scale": 0.1, "unit": "℃", "access": "R" },
        { "address": "40003", "name": "열풍 입구 온도", "code": "InletTemp", "type": "int16", "scale": 0.1, "unit": "℃", "access": "R" },
        { "address": "40004", "name": "배기 습도", "code": "Humidity", "type": "uint16", "scale": 0.1, "unit": "%RH", "access": "R" },
        { "address": "40005", "name": "히터 출력", "code": "HeaterPct", "type": "uint16", "scale": 0.1, "unit": "%", "access": "R" },
        { "address": "40006", "name": "송풍기 속도", "code": "FanPct", "type": "uint16", "scale": 0.1, "unit": "%", "access": "R" },
        { "address": "40007", "name": "배기 댐퍼 개도", "code": "DamperPct", "type": "uint16", "scale": 0.1, "unit": "%", "access": "R" },
        { "address": "40008", "name": "호퍼 재료 레벨", "code": "LevelPct", "type": "uint16", "scale": 0.1, "unit": "%", "access": "R" },
        { "address": "40009", "name": "상태", "code": "State", "type": "uint16", "access": "R",
          "codes": { "0": "정지", "1": "예열", "2": "건조", "3": "냉각", "4": "완료", "9": "고장" } },
        { "address": "40010", "name": "단계 남은 시간", "code": "StepRemainSec", "type": "uint16", "scale": 1, "unit": "s", "access": "R" },
        { "address": "40011", "name": "경보 비트", "code": "Alarms", "type": "bits", "access": "R",
          "bits": { "0": "과열", "1": "송풍기 과부하", "2": "문 열림", "3": "온도 센서 이상" } },
        { "address": "40012", "name": "설정 온도 (현재값)", "code": "SetTemp", "type": "int16", "scale": 0.1, "unit": "℃", "access": "R" },
        { "address": "00001", "name": "운전 중", "code": "Running", "type": "coil", "access": "R" },
        { "address": "00002", "name": "히터", "code": "HeaterOn", "type": "coil", "access": "R" },
        { "address": "00003", "name": "송풍기", "code": "FanOn", "type": "coil", "access": "R" },
        { "address": "00004", "name": "문 닫힘", "code": "DoorClosed", "type": "coil", "access": "R" },
        { "address": "00005", "name": "자동 모드", "code": "AutoMode", "type": "coil", "access": "R" },
        { "address": "00011", "name": "시작 명령", "code": "RunStart", "type": "coil", "access": "W", "how": "pulse",
          "note": "1 을 쓰면 장비가 받고 0 으로 되돌린다", "basis": "ai",
          "confirm": { "need": "safety", "answer": "맞음 — 매뉴얼의 '1 을 쓰면 시작' 이 그 뜻", "date": "2026-10-23", "via": "chat" },
          "device": { "check": "1 을 쓴 뒤 장비가 0 으로 되돌리는지", "done": null } },
        { "address": "00012", "name": "정지 명령", "code": "RunStopAsync, RunStop", "type": "coil", "access": "W", "how": "pulse",
          "note": "장비가 0 으로 되돌린다", "basis": "ai",
          "confirm": { "need": "safety", "answer": "맞음", "date": "2026-10-23", "via": "chat" },
          "device": { "check": "정지 명령을 장비가 받는지 (고온 정지 때)", "done": null } },
        { "address": "00013", "name": "리셋 명령", "code": "Reset", "type": "coil", "access": "W", "how": "pulse",
          "note": "장비의 고장·경보 상태를 푼다", "basis": "ai",
          "confirm": { "need": "safety", "answer": "맞음 — 1 을 쓰면 장비가 리셋하고 스스로 0 으로 되돌린다", "date": "2026-10-25", "via": "chat" } },
        { "address": "00014", "name": "자동 모드 명령", "code": "SetAuto", "type": "coil", "access": "W", "how": "hold",
          "note": "1 자동, 0 수동", "basis": "manual" },
        { "address": "40101", "name": "설정 온도 쓰기", "code": "SetTempAsync", "type": "int16", "scale": 0.1, "unit": "℃", "range": "20–정지 온도 미만", "access": "W", "how": "value", "basis": "manual" },
        { "address": "40111", "name": "레시피 예열 온도", "code": "WriteRecipeAsync", "type": "int16", "scale": 0.1, "unit": "℃", "access": "W", "how": "value", "note": "40111~40117 을 한 번에 쓴다", "basis": "manual" },
        { "address": "40112", "name": "레시피 예열 시간", "code": "WriteRecipeAsync", "type": "uint16", "scale": 1, "unit": "min", "access": "W", "how": "value", "basis": "manual" },
        { "address": "40113", "name": "레시피 건조 온도", "code": "WriteRecipeAsync", "type": "int16", "scale": 0.1, "unit": "℃", "access": "W", "how": "value", "basis": "manual" },
        { "address": "40114", "name": "레시피 건조 시간", "code": "WriteRecipeAsync", "type": "uint16", "scale": 1, "unit": "min", "access": "W", "how": "value", "basis": "manual" },
        { "address": "40115", "name": "레시피 냉각 온도", "code": "WriteRecipeAsync", "type": "int16", "scale": 0.1, "unit": "℃", "access": "W", "how": "value", "basis": "manual" },
        { "address": "40116", "name": "레시피 냉각 시간", "code": "WriteRecipeAsync", "type": "uint16", "scale": 1, "unit": "min", "access": "W", "how": "value", "basis": "manual" },
        { "address": "40117", "name": "레시피 송풍량", "code": "WriteRecipeAsync", "type": "uint16", "scale": 0.1, "unit": "%", "access": "W", "how": "value", "basis": "manual" }
      ]
    }
  ]
}
